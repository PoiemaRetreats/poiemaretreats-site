    "retreats": [
      {
        "id": "poiema-obx-2026",
        "slug": "poiema-obx-2026",
      "status": "draft",
        "data": {
          "title": "Poiema OBX 2026",
        "subtitle": "Kill Devil Hills, NC",
          "start_date": "2026-08-03T16:00:00.000Z",
          "end_date": "2026-08-07T11:00:00.000Z",
          "registration_deadline": "2026-07-20T23:59:59.000Z",
          "status_override": "automatic",
          "location": "Kill Devil Hills, Outer Banks, NC",
          "price": "$325",
        "easy_tithe_form_id": "aa7f78b7-1076-4016-a63b-047c6243fb71",
        "registration_url": "https://forms.gle/P56eUTsuWHw5aBHK7",
        "payment_url": "https://app.easytithe.com/app/giving/sppc",
          "excerpt": "Step out of the daily churn for rich interactive lectures, unhurried meals, coastal beauty, and deep Christian fellowship at the Outer Banks.",
          "content": [
            {
              "_type": "block",
              "_key": "obx1",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "obxs1",
                  "text": "The purpose of our retreats is to inform, encourage, and inspire Christian young adults regarding who they are in Christ. We see this as a life-awareness that is essential for everyone’s spiritual walk as well as the wellspring of joy and confidence. After all, we are God’s workmanship (poiema) and we want that to set in, be real to us, and when it does: worldview, apologetics, theology, vocation, and, well…all of life is set and in perspective."
                }
              ]
            },
            {
              "_type": "block",
              "_key": "obx2",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "obxs2",
                  "text": "Join us at Kill Devil Hills for four days of ocean breezes, sound biblical teaching, volleyball, laughter, and community with believers from across the region."
                }
              ]
            }
          ],
        "schedule": "",
        "lodging_info": ""
        }
      },
