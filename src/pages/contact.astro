---
import Base from "../layouts/Base.astro";
---

<Base
	title="Contact Us"
	description="Get in touch with the Poiema Retreats team regarding conferences, registration, or scholarships."
>
	<div class="contact-page">
		<header class="page-header">
			<div class="container">
				<span class="sub-heading">Get in Touch</span>
				<h1 class="page-title">Contact Poiema Retreats</h1>
				<p class="page-intro">
					Have questions regarding upcoming retreats, registration details, or financial aid? We would love to hear from you.
				</p>
			</div>
		</header>

		<section class="section">
			<div class="container">
				<div class="contact-grid">
					<div class="contact-methods">
						<h2>Send Us an Email</h2>
						<p class="contact-lead">
							Click below to open your preferred email client and send us a direct note. We typically reply within 24–48 business hours.
						</p>

						<div class="email-cards">
							<div class="email-card">
								<div class="email-card-body">
									<h3>Direct Pastoral Contact</h3>
									<p>Reach Pastor Laurence Windham directly regarding retreats, teaching, or pastoral questions.</p>
								</div>
								<a
									href="mailto:sppcpastor@gmail.com?subject=Poiema%20Retreats%20Inquiry"
									class="btn btn-primary email-btn"
								>
									Email Laurence Windham &rarr;
								</a>
							</div>

							<div class="email-card">
								<div class="email-card-body">
									<h3>Retreat Registration & Logistics</h3>
									<p>Questions regarding venue housing, meals, schedules, or payments.</p>
								</div>
								<a
									href="mailto:sppcpastor@gmail.com?subject=Retreat%20Registration%20Inquiry"
									class="btn btn-secondary email-btn"
								>
									Email Registration Team &rarr;
								</a>
							</div>

							<div class="email-card">
								<div class="email-card-body">
									<h3>Scholarships & Financial Aid</h3>
									<p>Inquire confidentially about need-based student registration assistance.</p>
								</div>
								<a
									href="mailto:sppcpastor@gmail.com?subject=Poiema%20Scholarship%20Inquiry"
									class="btn btn-secondary email-btn"
								>
									Email Scholarship Team &rarr;
								</a>
							</div>
						</div>
					</div>

					<aside class="contact-sidebar">
						<div class="sidebar-box">
							<h3>Direct Phone</h3>
							<p>For urgent questions or phone inquiries:</p>
							<a href="tel:4233662079" class="phone-link">
								<span class="phone-icon">&#9742;</span> 423-366-2079
							</a>
							<span class="phone-label">Pastor Laurence Windham</span>
						</div>

						<div class="sidebar-box">
							<h3>Ministry Location</h3>
							<p>
								Poiema Retreats operates under the oversight of the Session and Diaconate of <strong>Saint Peter Presbyterian Church</strong>.
							</p>
							<div class="address-card">
								<span class="address-title">Mailing Address</span>
								<p>
									Poiema Retreats<br />
									c/o Saint Peter Presbyterian Church<br />
									PO Box 16733<br />
									Bristol, VA 24209
								</p>
							</div>
						</div>
					</aside>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	.page-header {
		padding: var(--spacing-4xl) 0 var(--spacing-3xl);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.sub-heading {
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		display: block;
		margin-bottom: var(--spacing-xs);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		margin: 0 0 var(--spacing-md);
		color: var(--color-text-main);
	}

	.page-intro {
		max-width: 680px;
		margin: 0 auto;
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		line-height: 1.6;
		font-style: italic;
		font-family: var(--font-heading);
	}

	.section {
		padding: var(--spacing-4xl) 0 var(--spacing-5xl);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.contact-methods h2 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-xs);
		color: var(--color-text-main);
	}

	.contact-lead {
		font-size: var(--font-size-base);
		color: var(--color-text-muted);
		line-height: 1.6;
		margin-bottom: var(--spacing-2xl);
	}

	.email-cards {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
	}

	.email-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-xl);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.email-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px -2px rgba(0, 0, 0, 0.06);
	}

	.email-card-body h3 {
		font-size: var(--font-size-lg);
		margin-bottom: 4px;
		color: var(--color-text-main);
	}

	.email-card-body p {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		line-height: 1.5;
		margin: 0;
	}

	.email-btn {
		white-space: nowrap;
		flex-shrink: 0;
	}

	/* Sidebar */
	.contact-sidebar {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xl);
	}

	.sidebar-box {
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
	}

	.sidebar-box h3 {
		font-size: var(--font-size-lg);
		margin-bottom: var(--spacing-sm);
		color: var(--color-text-main);
	}

	.sidebar-box p {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		line-height: 1.6;
		margin-bottom: var(--spacing-md);
	}

	.phone-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-brand);
		text-decoration: none;
		margin-bottom: 4px;
	}

	.phone-link:hover {
		text-decoration: underline;
	}

	.phone-label {
		display: block;
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
	}

	.address-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--spacing-md) var(--spacing-lg);
	}

	.address-title {
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-accent);
		display: block;
		margin-bottom: 4px;
	}

	.address-card p {
		margin: 0;
		font-size: var(--font-size-xs);
		line-height: 1.6;
		color: var(--color-text-main);
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}

		.email-card {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--spacing-md);
		}

		.email-btn {
			width: 100%;
			text-align: center;
		}
	}
</style>
