---
import Base from "../layouts/Base.astro";
---

<Base
	title="Contact Us"
	description="Get in touch with the Poiema Retreats team regarding conferences, registration, or scholarships."
>
	<div class="contact-page">
		<header class="page-header">
			<div class="container">
				<span class="sub-heading">Get in Touch</span>
				<h1 class="page-title">Contact Poiema Retreats</h1>
				<p class="page-intro">
					Have questions regarding upcoming retreats, registration details, or financial aid? We would love to hear from you.
				</p>
			</div>
		</header>

		<section class="section">
			<div class="container">
				<div class="contact-grid">
					<div class="contact-methods">
						<h2>Send Us an Email</h2>
						<p class="contact-lead">
							Click below to open your preferred email client and send us a direct note. We typically reply within 24–48 business hours.
						</p>

						<div class="email-cards">
							<div class="email-card">
								<div class="email-card-body">
									<h3>General Inquiries</h3>
									<p>Questions about our mission, leadership, or general ministry details.</p>
								</div>
								<a
									href="mailto:contact@poiemaretreats.org?subject=Poiema%20Retreats%20General%20Inquiry"
									class="btn btn-primary email-btn"
								>
									Email General Team &rarr;
								</a>
							</div>

							<div class="email-card">
								<div class="email-card-body">
									<h3>Retreat Registration & Logistics</h3>
									<p>Questions regarding venue housing, meals, schedules, or payments.</p>
								</div>
								<a
									href="mailto:contact@poiemaretreats.org?subject=Retreat%20Registration%20Inquiry"
									class="btn btn-primary email-btn"
								>
									Email Registration Team &rarr;
								</a>
							</div>

							<div class="email-card">
								<div class="email-card-body">
									<h3>Scholarships & Financial Aid</h3>
									<p>Inquire confidentially about need-based student registration assistance.</p>
								</div>
								<a
									href="mailto:contact@poiemaretreats.org?subject=Poiema%20Scholarship%20Inquiry"
									class="btn btn-secondary email-btn"
								>
									Email Scholarship Team &rarr;
								</a>
							</div>
						</div>
					</div>

					<aside class="contact-sidebar">
						<div class="sidebar-box">
							<h3>Ministry Location</h3>
							<p>
								Poiema Retreats operates under the oversight of the Session of <strong>Saint Peter Presbyterian Church</strong>.
							</p>
							<div class="address-card">
								<span class="address-title">Mailing Address</span>
								<p>
									Poiema Retreats<br />
									c/o Saint Peter Presbyterian Church<br />
									PO Box 16733<br />
									Bristol, VA 24209
								</p>
							</div>
						</div>

						<div class="sidebar-box pastoral-box">
							<h3>Pastoral Oversight</h3>
							<p>
								If you are a pastor interested in partnering, bringing a college group, or speaking at a future retreat, please contact our ministry coordinators directly at <a href="mailto:pastor@poiemaretreats.org">pastor@poiemaretreats.org</a>.
							</p>
						</div>
					</aside>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	.page-header {
		padding: var(--spacing-4xl) 0 var(--spacing-3xl);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.sub-heading {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		display: block;
		margin-bottom: var(--spacing-xs);
	}

	.page-title {
		margin: 0 0 var(--spacing-md);
		color: var(--color-text);
	}

	.page-intro {
		max-width: 620px;
		margin: 0 auto;
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}

	.section {
		padding: var(--spacing-4xl) 0 var(--spacing-5xl);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.contact-methods h2 {
		font-size: var(--font-size-3xl);
		margin: 0 0 var(--spacing-xs);
	}

	.contact-lead {
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
		margin: 0 0 var(--spacing-2xl);
	}

	.email-cards {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
	}

	.email-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-xl);
		box-shadow: var(--shadow-sm);
	}

	.email-card-body h3 {
		margin: 0 0 var(--spacing-xs);
		font-size: var(--font-size-xl);
	}

	.email-card-body p {
		margin: 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.email-btn {
		white-space: nowrap;
		flex-shrink: 0;
	}

	.contact-sidebar {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xl);
	}

	.sidebar-box {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
	}

	.sidebar-box h3 {
		margin: 0 0 var(--spacing-sm);
		font-size: var(--font-size-xl);
	}

	.sidebar-box p {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-normal);
		margin: 0 0 var(--spacing-md);
	}

	.address-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--spacing-md) var(--spacing-lg);
	}

	.address-title {
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-muted);
		display: block;
		margin-bottom: var(--spacing-xs);
	}

	.address-card p {
		margin: 0;
		color: var(--color-text);
		font-size: var(--font-size-sm);
		line-height: var(--leading-normal);
	}

	.pastoral-box {
		background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
		border-color: color-mix(in srgb, var(--color-accent) 25%, var(--color-border));
	}

	.pastoral-box a {
		color: var(--color-brand);
		font-weight: 600;
	}

	@media (max-width: 800px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}

		.email-card {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--spacing-md);
		}

		.email-btn {
			width: 100%;
		}
	}
</style>
