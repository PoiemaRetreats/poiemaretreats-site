---
import Base from "../layouts/Base.astro";
import EasyTitheEmbed from "../components/EasyTitheEmbed.astro";
---

<Base
	title="Support & Give"
	description="Support Poiema Retreats through tax-deductible giving to fund college scholarships and theological conferences."
>
	<div class="funding-page">
		<header class="page-header">
			<div class="container">
				<span class="sub-heading">Financial Stewardship & Giving</span>
				<h1 class="page-title">Support Poiema Retreats</h1>
				<p class="page-intro">
					Investing in the formation, faith, and lifelong discipleship of young adults across the church of Jesus Christ.
				</p>
			</div>
		</header>

		<section class="section">
			<div class="container">
				<div class="funding-grid">
					<div class="funding-info">
						<div class="info-block">
							<h2>Why We Give</h2>
							<p>
								Many of our attendees are college students, recent graduates, or young workers navigating early career stages. We deliberately price our retreats below the actual cost per person so that cost is never a barrier to Christian community.
							</p>
							<p>
								Your contributions make up the difference: funding venue deposits, communal feasts, speaker honorariums, and direct student scholarships.
							</p>
						</div>

						<div class="giving-pillars">
							<div class="pillar-card">
								<div class="pillar-number">01</div>
								<div class="pillar-body">
									<h3>Need-Based Scholarships</h3>
									<p>Providing full and partial registration aid so students facing hardship can attend without anxiety.</p>
								</div>
							</div>

							<div class="pillar-card">
								<div class="pillar-number">02</div>
								<div class="pillar-body">
									<h3>Subsidized Registration</h3>
									<p>Keeping base fees accessible for all attendees through upfront hospitality underwriting.</p>
								</div>
							</div>

							<div class="pillar-card">
								<div class="pillar-number">03</div>
								<div class="pillar-body">
									<h3>International Study Tours</h3>
									<p>Supporting historical church history tours and collaborative conferences with European sister churches.</p>
								</div>
							</div>
						</div>

						<div class="check-box">
							<h3>Giving by Mail</h3>
							<p>
								Tax-deductible checks may be made payable to <strong>Saint Peter Presbyterian Church</strong> with <em>"Poiema Retreats"</em> in the memo line.
							</p>
							<p class="church-address">
								<strong>Saint Peter Presbyterian Church</strong><br />
								Attn: Poiema Retreats Ministry<br />
								PO Box 16733<br />
								Bristol, VA 24209
							</p>
						</div>
					</div>

					<div class="funding-embed">
						<EasyTitheEmbed
							formId="aa7f78b7-1076-4016-a63b-047c6243fb71"
							title="Give Online"
							subtitle="Secure tax-deductible donations processed via MinistryForms / EasyTithe."
						/>
					</div>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	.page-header {
		padding: var(--spacing-4xl) 0 var(--spacing-3xl);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.sub-heading {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		display: block;
		margin-bottom: var(--spacing-xs);
	}

	.page-title {
		margin: 0 0 var(--spacing-md);
		color: var(--color-text);
	}

	.page-intro {
		max-width: 650px;
		margin: 0 auto;
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}

	.section {
		padding: var(--spacing-4xl) 0 var(--spacing-5xl);
	}

	.funding-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.info-block h2 {
		font-size: var(--font-size-3xl);
		margin: 0 0 var(--spacing-md);
	}

	.info-block p {
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
		margin-bottom: var(--spacing-lg);
	}

	.giving-pillars {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		margin: var(--spacing-2xl) 0;
	}

	.pillar-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--spacing-lg);
		display: flex;
		gap: var(--spacing-lg);
		align-items: flex-start;
	}

	.pillar-number {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: 700;
		color: var(--color-ochre);
		line-height: 1;
	}

	.pillar-body h3 {
		margin: 0 0 var(--spacing-xs);
		font-size: var(--font-size-lg);
	}

	.pillar-body p {
		margin: 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.check-box {
		background: color-mix(in srgb, var(--color-brand) 6%, var(--color-surface));
		border: 1px solid color-mix(in srgb, var(--color-brand) 20%, var(--color-border));
		border-radius: var(--radius);
		padding: var(--spacing-xl);
		margin-top: var(--spacing-2xl);
	}

	.check-box h3 {
		margin: 0 0 var(--spacing-xs);
		font-size: var(--font-size-xl);
	}

	.check-box p {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-normal);
		margin: 0 0 var(--spacing-md);
	}

	.church-address {
		margin: 0 !important;
		font-size: var(--font-size-sm);
		color: var(--color-text) !important;
		line-height: var(--leading-normal);
	}

	.funding-embed :global(.easytithe-wrapper) {
		margin: 0;
	}

	@media (max-width: 900px) {
		.funding-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
