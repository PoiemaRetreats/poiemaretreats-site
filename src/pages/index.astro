---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-iconset/components";
import { copy } from "../data/original-copy";
const testimonials = [
  "“It was so nice to hang out with other Christians my age and hear lectures aimed towards us.”",
  "“The lectures were thought provoking, at times convicting…”",
  "“It was a huge blessing to be with the body of Christ and see that we are larger than just our small church.”",
  "“It was an incredible experience!”",
  "“I was so encouraged and refreshed”",
];
---
<Base title="Poiema Retreats" description={copy.purpose} image="/images/poiema-gathering.webp">
  <section class="home-hero">
    <img class="hero-photo" src="/images/poiema-gathering.webp" alt="Poiema retreat attendees gathered together" width="1334" height="885" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <p class="scripture">{copy.scripture} – <span>{copy.reference}</span></p>
      <h1>{copy.headline}</h1>
      <a class="btn btn-primary" href="/retreats">{copy.retreatCta}</a>
    </div>
  </section>

  <section class="wrap purpose" aria-label="Our purpose">
    <p>{copy.purpose} {copy.awareness}</p>
    <p>{copy.workmanship}</p>
  </section>

  <section class="wrap testimonials" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title">TESTIMONIALS:</h2>
    <div class="quotes">{testimonials.map(quote => <blockquote>{quote}</blockquote>)}</div>
  </section>

  <section class="retreat-section" aria-label="Retreats">
    <div class="wrap retreat-grid">
      <article class="retreat">
        <img src="/images/poiema-obx.webp" alt="Poiema OBX retreat photograph" loading="lazy" />
        <h3>Poiema obx 2026</h3>
        <p><strong>August 3rd-7th, 2025 | </strong>Kill Devil Hills, NC</p>
        <a class="btn btn-secondary" href="/registration">Learn More</a>
      </article>
      <article class="retreat">
        <img src="/images/poiema-poland.webp" alt="Poiema International Poland retreat information" loading="lazy" />
        <h3>Poiema International: Gdansk</h3>
        <p><strong>MAY 29TH-JUNE 8TH | </strong>Poland</p>
        <a class="btn btn-secondary" href="https://poiemaretreats.org/poiema-international-2025-registration/">Learn More</a>
      </article>
    </div>
    <p class="wrap date-note">Dates are reproduced from the original site. <a href="/contact">Contact us</a> for current retreat information.</p>
  </section>

  <section class="wrap feature media-section" aria-labelledby="media-title">
    <div><h2 id="media-title">{copy.media}</h2><a class="btn btn-primary" href="/media">{copy.mediaCta}</a></div>
    <img src="/images/poiema-media.webp" alt="Teaching at a Poiema retreat" loading="lazy" />
  </section>

  <section class="donate-section" aria-labelledby="donate-title">
    <div class="wrap feature">
      <img src="/images/poiema-donate.webp" alt="Poiema retreat photo" loading="lazy" />
      <div><h2 id="donate-title">Donate</h2><p>{copy.donate}</p><p>{copy.donationPurpose}</p><a class="btn btn-primary" href="/funding">{copy.donationCta}</a></div>
    </div>
  </section>

  <section class="wrap values" aria-label="Poiema values">
    <div><Icon name="ph:book-open" aria-hidden="true" /><h3>Encouragement</h3><p><em>{copy.encouragementVerse}</em></p><p>{copy.encouragement}</p></div>
    <div><Icon name="ph:users-three" aria-hidden="true" /><h3>Communication</h3><p>{copy.communication}</p></div>
    <div><Icon name="ph:heart" aria-hidden="true" /><h3>JOY</h3><p>{copy.joy}</p></div>
    <div><Icon name="ph:church" aria-hidden="true" /><h3>Life Together</h3><p>{copy.life} {copy.closing}</p></div>
  </section>

  <section class="closing-section">
    <img src="/images/poiema-fellowship.webp" alt="" loading="lazy" />
    <div class="wrap"><h2>{copy.grow}</h2><a class="btn btn-primary" href="/retreats">SEE UPCOMING RETREATS</a></div>
  </section>
</Base>

<style>
.wrap{max-width:1200px;margin:0 auto;padding-left:32px;padding-right:32px}
.home-hero{position:relative;min-height:560px;display:flex;align-items:center;color:#fff;background:#28382d;overflow:hidden}
.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 64%}
.hero-shade{position:absolute;inset:0;background:rgba(15,24,19,.56)}
.hero-content{position:relative;width:100%;text-align:center;padding-top:80px;padding-bottom:80px}
.scripture{font-size:14px;line-height:1.7;font-weight:500;margin:0 auto 28px;max-width:850px;color:#fff}.scripture span{white-space:nowrap}
.home-hero h1{font-size:clamp(40px,4.5vw,64px);font-weight:500;line-height:1.15;margin:0 auto 38px;max-width:850px}
h2{font-size:clamp(28px,3vw,40px);font-weight:500;line-height:1.25;margin:0 0 24px}
p{font-size:16px;line-height:1.8;color:var(--color-muted)}
.purpose{max-width:1080px;padding-top:64px;padding-bottom:28px}.purpose p{font-size:18px;margin:0 0 24px}
.testimonials{text-align:center;padding-top:28px;padding-bottom:64px}.testimonials h2{font-size:30px}.quotes{max-width:850px;margin:auto;display:grid;gap:20px}.quotes blockquote{font:italic 18px/1.65 Georgia,serif;color:var(--color-text);margin:0}
.retreat-section{background:var(--color-surface);padding:56px 0}.retreat-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}.retreat img{width:100%;height:320px;object-fit:contain;background:var(--color-bg);display:block}.retreat h3{font-size:29px;margin:26px 0 12px}.retreat p{font-size:15px;margin:0 0 24px}.date-note{font-size:12px;margin-top:30px}.date-note a{color:inherit;text-decoration:underline}
.feature{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;padding-top:70px;padding-bottom:70px}.feature img{width:100%;height:360px;object-fit:contain}.feature h2{max-width:540px}.feature .btn{margin-top:14px}.donate-section{background:var(--color-surface)}
.values{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:34px;padding-top:70px;padding-bottom:70px}.values h3{font-size:26px;margin:18px 0}.values p{font-size:14px;margin:0 0 16px}.values :global(svg){width:34px;height:34px;color:var(--color-accent)}
.closing-section{position:relative;text-align:center;padding:90px 0;overflow:hidden;color:#fff;background:#1e2a24}.closing-section>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.2}.closing-section .wrap{position:relative}.closing-section h2{max-width:800px;margin:0 auto 32px}
@media(max-width:760px){.wrap{padding-left:22px;padding-right:22px}.home-hero{min-height:520px}.hero-content{padding-top:50px;padding-bottom:50px}.home-hero h1{font-size:39px}.scripture{font-size:13px}.purpose{padding-top:40px}.purpose p{font-size:16px}.testimonials{padding-bottom:44px}.retreat-grid,.feature{grid-template-columns:1fr;gap:36px}.retreat-section{padding:40px 0}.retreat img{height:290px}.feature{padding-top:44px;padding-bottom:44px}.feature img{height:290px}.values{grid-template-columns:1fr 1fr;gap:28px;padding-top:44px;padding-bottom:44px}.closing-section{padding:64px 0}.btn{max-width:100%;white-space:normal;text-align:center}.media-section>img{grid-row:1}}
@media(max-width:420px){.values{grid-template-columns:1fr}}
</style>
