---
import Base from "../layouts/Base.astro";
---

<Base
	title="Funding & Financial Stewardship"
	description="We appreciate your financial help. Supporting Poiema Retreats keeps registration affordable and funds scholarships."
>
	<div class="funding-page">
		<header class="page-header">
			<div class="container opening-grid">
				<div>
				<span class="sub-heading">Financial Stewardship & Giving</span>
				<h1 class="page-title">Funding & Donations</h1>
				<p class="page-intro">
					We appreciate your financial help. The purpose of our ministry is to inform, encourage, and inspire Christian young adults regarding who they are in Christ.
				</p>
				</div>
				<img class="opening-photo" src="/images/funding-group.webp" alt="Poiema retreat attendees gathered outdoors" width="809" height="606" fetchpriority="high" />
			</div>
		</header>

		<section class="section">
			<div class="container">
				<div class="funding-grid">
					<div class="funding-info">
						<div class="info-block">
							<h2>Here’s what we do with your donations:</h2>
							<ul class="donation-uses-list">
								<li>
									<strong>Affordable Retreats:</strong> We keep the cost of our retreats affordable. The registration fees do not cover all of our costs. We don’t want expense to be the reason that someone doesn’t attend.
								</li>
								<li>
									<strong>Speaker & Helper Expenses:</strong> We basically pay the travel and retreat expenses of all of our speakers and helpers and, when we can, we give our guest speakers a little extra.
								</li>
								<li>
									<strong>Website:</strong> We use donations to build and maintain our website.
								</li>
							</ul>
						</div>

						<div class="info-block">
							<h2>Here is what we would do with more money:</h2>
							<ul class="donation-uses-list">
								<li>Ministry Internships</li>
								<li>Summer Study Program</li>
								<li>Purchase of selected books for our attendees</li>
								<li>Start Poiema International, taking young adults on retreats to other countries to be immersed in the work of Christ in other parts of the world</li>
								<li>Compensate writers, composers, lecturers, artists, organizers, and techies to help us in this ministry</li>
							</ul>
						</div>

						<!-- Monthly Donor Mug Callout -->
						<div class="mug-callout-card">
							<div class="mug-content">
								<span class="mug-badge">Monthly Partner Program</span>
								<h3>Receive a Poiema Coffee Mug</h3>
								<p>
									If you’d like, we have a monthly donor program that if you sign up (for whatever amount) we will send you one of our coffee mugs as a token of our thanks and as a reminder to pray for the ministry as partners with us.
								</p>
							</div>
						</div>

						<div class="info-block church-oversight-block">
							<h2>Church Oversight & Diaconate</h2>
							<p>
								You should know that Poiema Retreats is a ministry of <strong>Saint Peter Presbyterian Church</strong> in Bristol, Virginia. All registrations and donations are received by our church treasurer and overseen by our diaconate.
							</p>
						</div>
					</div>

					<aside class="donation-card-container">
						<img class="giving-photo" src="/images/funding-shirt.webp" alt="Retreat attendee wearing a Poiema shirt and hat beside the water" width="720" height="720" loading="lazy" />
						<div class="donation-card">
							<h3>Donate to Poiema</h3>
							<p class="donation-intro">
								Give securely online via Saint Peter Presbyterian Church’s online portal. Select <strong>“Poiema”</strong> as the designated fund.
							</p>

							<div class="direct-link-box">
								<a
									href="https://app.easytithe.com/app/giving/sppc"
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn-secondary w-full"
								>
									Open EasyTithe Giving Portal &rarr;
								</a>
							</div>
						</div>
					</aside>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.opening-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 48px; align-items: center; text-align: left; }
	.opening-photo { display: block; width: 100%; height: auto; border-radius: var(--radius-lg); }
	.giving-photo { display: block; width: 100%; height: auto; border-radius: var(--radius-lg); margin-bottom: 24px; }
	@media (max-width: 860px) { .opening-grid { grid-template-columns: 1fr; gap: 28px; } }
	.container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	.page-header {
		padding: var(--spacing-4xl) 0 var(--spacing-3xl);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.sub-heading {
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		display: block;
		margin-bottom: var(--spacing-xs);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		margin: 0 0 var(--spacing-md);
		color: var(--color-text-main);
	}

	.page-intro {
		max-width: 680px;
		margin: 0 auto;
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		line-height: 1.6;
		font-style: italic;
		font-family: var(--font-heading);
	}

	.section {
		padding: var(--spacing-4xl) 0 var(--spacing-5xl);
	}

	.funding-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.info-block {
		margin-bottom: var(--spacing-3xl);
	}

	.info-block h2 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-md);
		color: var(--color-text-main);
	}

	.donation-uses-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.donation-uses-list li {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-brand);
		border-radius: var(--radius-md);
		padding: var(--spacing-md) var(--spacing-lg);
		font-size: var(--font-size-sm);
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	.donation-uses-list strong {
		color: var(--color-text-main);
		font-size: var(--font-size-base);
		display: block;
		margin-bottom: 2px;
	}

	/* Future Initiatives Grid */
	.future-initiatives-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--spacing-md);
	}

	.initiative-card {
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--spacing-md) var(--spacing-lg);
	}

	.initiative-card h3 {
		font-size: var(--font-size-base);
		color: var(--color-text-main);
		margin: 0 0 var(--spacing-xs);
	}

	.initiative-card p {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		line-height: 1.5;
		margin: 0;
	}

	/* Mug Callout */
	.mug-callout-card {
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--color-brand) 12%, var(--color-surface)),
			color-mix(in srgb, var(--color-accent) 10%, var(--color-surface))
		);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		margin-bottom: var(--spacing-3xl);
	}

	.mug-badge {
		display: inline-block;
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: var(--spacing-xs);
	}

	.mug-content h3 {
		font-size: var(--font-size-xl);
		color: var(--color-text-main);
		margin: 0 0 var(--spacing-sm);
	}

	.mug-content p {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		line-height: 1.6;
		margin: 0;
	}

	.church-oversight-block p {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	/* Donation Card */
	.donation-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-2xl);
		box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
	}

	.donation-card h3 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-xs);
		color: var(--color-text-main);
	}

	.donation-intro {
		color: var(--color-text-muted);
		font-size: var(--font-size-xs);
		line-height: 1.5;
		margin-bottom: var(--spacing-xl);
	}

	.direct-link-box {
		margin-top: var(--spacing-xl);
		padding-top: var(--spacing-lg);
		border-top: 1px solid var(--color-border);
		text-align: center;
	}

	.direct-link-note {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		margin-bottom: var(--spacing-sm);
	}

	.mail-donation {
		margin-top: var(--spacing-xl);
		padding-top: var(--spacing-lg);
		border-top: 1px solid var(--color-border);
	}

	.mail-donation h4 {
		font-size: var(--font-size-sm);
		margin-bottom: var(--spacing-xs);
		color: var(--color-text-main);
	}

	.mail-donation p {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		line-height: 1.4;
		margin-bottom: var(--spacing-sm);
	}

	.mail-address {
		font-style: normal;
		font-size: var(--font-size-xs);
		line-height: 1.5;
		background: var(--color-surface-soft);
		padding: var(--spacing-md);
		border-radius: var(--radius-sm);
		color: var(--color-text-main);
		font-family: monospace;
	}

	.w-full {
		width: 100%;
		display: block;
		text-align: center;
	}

	@media (max-width: 860px) {
		.funding-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
