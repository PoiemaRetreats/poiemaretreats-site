---
interface Props {
	formId?: string;
	title?: string;
	subtitle?: string;
}

const {
	formId = "aa7f78b7-1076-4016-a63b-047c6243fb71",
	title,
	subtitle,
} = Astro.props;

// Extract GUID if full URL was provided
const cleanFormId = formId?.includes("formId=")
	? formId.split("formId=")[1].split("&")[0]
	: formId?.trim();
---

<div class="easytithe-wrapper" id={`form-section-${cleanFormId}`}>
	<div class="easytithe-card">
		<div class="easytithe-header">
			<span class="easytithe-badge">Secure Registration & Giving</span>
			{title && <h3 class="easytithe-title">{title}</h3>}
			{subtitle && <p class="easytithe-subtitle">{subtitle}</p>}
		</div>

		<div class="easytithe-frame">
			<script is:inline src={`https://forms.ministryforms.net/embed.aspx?formId=${cleanFormId}`}></script>
		</div>

		<div class="easytithe-footer">
			<span class="lock-icon" aria-hidden="true">&#128274;</span>
			<span>Protected by 256-bit SSL encryption via MinistryForms / EasyTithe</span>
		</div>
	</div>
</div>

<style>
	.easytithe-wrapper {
		width: 100%;
		margin: var(--spacing-xl) 0;
	}

	.easytithe-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		overflow: hidden;
		box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
	}

	.easytithe-header {
		padding: var(--spacing-xl) var(--spacing-2xl);
		background: var(--color-surface-soft);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.easytithe-badge {
		display: inline-block;
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
		margin-bottom: var(--spacing-xs);
	}

	.easytithe-title {
		font-size: var(--font-size-2xl);
		margin: 0 0 var(--spacing-xs);
		color: var(--color-text-main);
	}

	.easytithe-subtitle {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		margin: 0;
	}

	.easytithe-frame {
		padding: var(--spacing-xl);
		min-height: 480px;
		background: #ffffff;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.easytithe-footer {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-sm);
		padding: var(--spacing-md);
		background: var(--color-surface-soft);
		border-top: 1px solid var(--color-border);
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
	}

	.lock-icon {
		font-size: var(--font-size-sm);
	}
</style>
