---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/articles");
}

const { entry: article, cacheHint } = await getEmDashEntry("articles", slug);

if (!article) {
	return Astro.redirect("/404");
}

if (cacheHint) {
	Astro.cache.set(cacheHint);
}

const formattedDate = article.data.published_at
	? new Date(article.data.published_at).toLocaleDateString("en-US", {
			month: "long",
			day: "numeric",
			year: "numeric",
		})
	: null;
---

<Base
	title={article.data.title}
	description={article.data.excerpt}
>
	<article class="article-detail-page" {...article.edit}>
		<header class="article-header">
			<div class="container">
				<a href="/articles" class="back-link">&larr; Back to all articles</a>

				<div class="article-meta">
					<span class="article-author">{article.data.author}</span>
					{formattedDate && (
						<>
							<span class="meta-dot">&bull;</span>
							<time datetime={article.data.published_at}>{formattedDate}</time>
						</>
					)}
				</div>

				<h1 class="article-title">{article.data.title}</h1>

				{article.data.excerpt && (
					<p class="article-lead">{article.data.excerpt}</p>
				)}
			</div>
		</header>

		<div class="container article-body-container">
			<div class="article-body prose">
				{article.data.content && <PortableText value={article.data.content} />}
			</div>

			<footer class="article-footer-box">
				<div class="author-note">
					<h4>About the Ministry</h4>
					<p>
						Poiema Retreats is a ministry of Saint Peter Presbyterian Church in Bristol, Virginia, gathering young adults from across the nation for theological study, godly fellowship, and Sabbath rest.
					</p>
					<a href="/about" class="learn-more-link">Learn more about our mission &rarr;</a>
				</div>
			</footer>
		</div>
	</article>
</Base>

<style>
	.container {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	.article-header {
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		padding: var(--spacing-3xl) 0 var(--spacing-3xl);
	}

	.back-link {
		display: inline-block;
		color: var(--color-muted);
		text-decoration: none;
		font-size: var(--font-size-sm);
		font-weight: 500;
		margin-bottom: var(--spacing-lg);
		transition: color var(--transition-fast);
	}

	.back-link:hover {
		color: var(--color-text);
	}

	.article-meta {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-bottom: var(--spacing-sm);
		display: flex;
		align-items: center;
		gap: var(--spacing-xs);
	}

	.article-author {
		font-weight: 600;
		color: var(--color-accent);
	}

	.meta-dot {
		opacity: 0.5;
	}

	.article-title {
		margin: 0 0 var(--spacing-md);
		font-size: var(--font-size-4xl);
		line-height: var(--leading-tight);
		color: var(--color-text);
	}

	.article-lead {
		font-size: var(--font-size-xl);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
		margin: 0;
		font-style: italic;
	}

	.article-body-container {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-5xl);
	}

	.article-body {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
	}

	.article-body :global(p) {
		margin-bottom: var(--spacing-xl);
	}

	.article-body :global(h2) {
		margin-top: var(--spacing-3xl);
		margin-bottom: var(--spacing-md);
	}

	.article-body :global(blockquote) {
		border-left: 3px solid var(--color-accent);
		margin: var(--spacing-2xl) 0;
		padding-left: var(--spacing-lg);
		color: var(--color-muted);
		font-style: italic;
	}

	.article-footer-box {
		margin-top: var(--spacing-5xl);
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-2xl);
	}

	.author-note {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--spacing-xl);
	}

	.author-note h4 {
		margin: 0 0 var(--spacing-xs);
		font-size: var(--font-size-base);
		color: var(--color-text);
	}

	.author-note p {
		margin: 0 0 var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: var(--leading-relaxed);
	}

	.learn-more-link {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: none;
	}

	.learn-more-link:hover {
		text-decoration: underline;
	}
</style>
