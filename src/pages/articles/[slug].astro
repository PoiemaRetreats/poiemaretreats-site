---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/articles");
}

const { entry: article, cacheHint } = await getEmDashEntry("articles", slug);

if (!article) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled && cacheHint) {
	Astro.cache.set(cacheHint);
}

const rawDate = article.data.publishedAt;
const formattedDate = rawDate
	? new Date(rawDate).toLocaleDateString("en-US", {
			month: "long",
			day: "numeric",
			year: "numeric",
		})
	: null;
---

<Base
	title={article.data.title}
	description={article.data.excerpt}
>
	<article class="article-detail-page" {...article.edit}>
		<header class="article-header">
			<div class="container">
				<a href="/articles" class="back-link">&larr; Back to all articles</a>

				<div class="article-meta">
					<span class="article-author">{article.data.author}</span>
					{formattedDate && (
						<>
							<span class="meta-dot">&bull;</span>
							<time datetime={rawDate ? new Date(rawDate).toISOString() : undefined}>{formattedDate}</time>
						</>
					)}
				</div>

				<h1 class="article-title">{article.data.title}</h1>

				{article.data.excerpt && (
					<p class="article-lead">{article.data.excerpt}</p>
				)}
			</div>
		</header>

		<section class="article-content-section">
			<div class="container prose-container">
				{article.data.content ? (
					<div class="prose-content">
						<PortableText value={article.data.content} />
					</div>
				) : (
					<p class="article-empty">No body content provided for this article.</p>
				)}

				<footer class="article-footer">
					<div class="author-bio-card">
						<div class="author-bio-info">
							<span class="bio-author-name">{article.data.author}</span>
							<p>Pastoral teacher and contributor to Poiema Retreats conferences.</p>
						</div>
					</div>

					<div class="footer-cta-box">
						<h3>Join Us at Our Next Gathering</h3>
						<p>Experience in-person fellowship, teaching, and shared tables at an upcoming retreat.</p>
						<a href="/retreats" class="btn btn-primary">View Upcoming Retreats &rarr;</a>
					</div>
				</footer>
			</div>
		</section>
	</article>
</Base>

<style>
	.container {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	.prose-container {
		max-width: 680px;
	}

	.article-header {
		padding: var(--spacing-4xl) 0 var(--spacing-3xl);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.back-link {
		display: inline-block;
		font-size: var(--font-size-xs);
		color: var(--color-brand);
		font-weight: 600;
		text-decoration: none;
		margin-bottom: var(--spacing-lg);
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		margin-bottom: var(--spacing-md);
	}

	.article-author {
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
	}

	.meta-dot {
		color: var(--color-border);
	}

	.article-title {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.2;
		color: var(--color-text-main);
		margin-bottom: var(--spacing-lg);
	}

	.article-lead {
		font-size: var(--font-size-lg);
		line-height: 1.6;
		color: var(--color-text-muted);
		font-style: italic;
		border-left: 3px solid var(--color-brand);
		padding-left: var(--spacing-lg);
		margin: 0;
	}

	.article-content-section {
		padding: var(--spacing-5xl) 0;
	}

	.prose-content {
		font-size: var(--font-size-base);
		line-height: 1.8;
		color: var(--color-text-main);
	}

	.prose-content p {
		margin-bottom: var(--spacing-xl);
	}

	.article-footer {
		margin-top: var(--spacing-5xl);
		padding-top: var(--spacing-3xl);
		border-top: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl);
	}

	.author-bio-card {
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
	}

	.bio-author-name {
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-text-main);
		display: block;
		margin-bottom: var(--spacing-xs);
	}

	.author-bio-card p {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		margin: 0;
		line-height: 1.5;
	}

	.footer-cta-box {
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--color-brand) 10%, var(--color-surface)),
			var(--color-surface)
		);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		text-align: center;
	}

	.footer-cta-box h3 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-xs);
		color: var(--color-text-main);
	}

	.footer-cta-box p {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		margin-bottom: var(--spacing-lg);
	}
</style>
