      },
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "About Poiema",
          "content": [
            {
              "_type": "block",
              "_key": "ab1",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "abs1",
                  "text": "Poiema was launched out of a passion to see young adults encouraged in their walk with Christ and to see them operating as vital members of their local congregations. Often overlooked, too often not considered as important (until they are married) and sometimes limited in fellowshipping with peers due to the size of their church; Poiema was started to help yours and ours. And it seems to be working."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "funding",
        "slug": "funding",
        "status": "published",
        "data": {
          "title": "Funding & Financial Stewardship",
          "content": [
            {
              "_type": "block",
              "_key": "f1",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "fs1",
                  "text": "We appreciate your financial help. We keep the cost of our retreats affordable; the registration fees do not cover all of our costs. We don’t want expense to be the reason that someone doesn’t attend. All registrations and donations are received by Saint Peter Presbyterian Church in Bristol, Virginia and overseen by our diaconate."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "contact",
        "slug": "contact",
        "status": "published",
        "data": {
          "title": "Contact Us",
          "content": [
            {
              "_type": "block",
              "_key": "ct1",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "cts1",
                  "text": "Have a question about upcoming retreats, registration, speaking, or scholarship assistance? Contact Laurence Windham at 423-366-2079 or sppcpastor@gmail.com."
                }
              ]
            }
