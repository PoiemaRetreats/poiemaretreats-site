---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { copy } from "../data/original-copy";
import { getRetreatStatus } from "../utils/retreats";
const { entries, cacheHint } = await getEmDashCollection("retreats", { status: "published" });
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
const upcoming = entries.filter(r => !getRetreatStatus(r.data).isPast).sort((a,b) => new Date(a.data.start_date).getTime()-new Date(b.data.start_date).getTime()).slice(0,3);
---
<Base title="Christian young adult retreats" description="Teaching, fellowship, and encouragement for Christian young adults. Discover Poiema Retreats, a ministry of Saint Peter Presbyterian Church." image="/images/poiema-gathering.webp">
  <section class="home-hero">
    <img class="hero-photo" src="/images/poiema-gathering.webp" alt="Poiema retreat attendees gathered together" width="1334" height="885" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <p class="scripture">{copy.scripture} <span>{copy.reference}</span></p>
      <h1>{copy.headline}</h1>
      <a class="btn btn-primary hero-button" href="/retreats">{copy.retreatCta} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="wrap introduction">
    <div><p class="small-label">ποίημα</p><h2>What is our Purpose?</h2></div>
    <div class="intro-copy"><p>The purpose of our retreats is to inform, encourage, and inspire Christian young adults regarding who they are in Christ.</p><p>We see this as a life-awareness that is essential for everyone’s spiritual walk as well as the wellspring of joy and confidence.</p><a class="text-link" href="/about">About <span aria-hidden="true">→</span></a></div>
  </section>
  <section class="gatherings-section">
    <div class="wrap">
      <div class="section-top"><h2>Retreats</h2><a class="text-link" href="/retreats">{copy.retreatCta} <span aria-hidden="true">→</span></a></div>
      {upcoming.length > 0 ? <div class="retreat-list">{upcoming.map(retreat => <a class="retreat-item" href={`/retreats/${retreat.id}`} {...retreat.edit}><div><span>{getRetreatStatus(retreat.data).dateRangeFormatted}</span><h3>{retreat.data.title}</h3><p>{retreat.data.location}</p></div><span aria-hidden="true">↗</span></a>)}</div> : <div class="season-note"><div><h3>Retreats</h3><p>Contact us for information about upcoming retreats.</p></div><a class="btn btn-secondary" href="/contact">Contact <span aria-hidden="true">→</span></a></div>}
      <div class="retreat-intro"><img src="/images/poiema-fellowship.webp" alt="Fellowship at a Poiema retreat" width="1920" height="1280" loading="lazy" /><div><h3>What are we about?</h3><p>{copy.origin}</p><p>{copy.workmanship}</p><a class="text-link" href="/about">About <span aria-hidden="true">→</span></a></div></div>
    </div>
  </section>
  <section class="wrap voices"><p class="small-label">TESTIMONIALS:</p><blockquote>“It was a huge blessing to be with the body of Christ and see that we are larger than just our small church.”</blockquote><div class="more-voices"><p>“It was so nice to hang out with other Christians my age and hear lectures aimed towards us.”</p><p>“I was so encouraged and refreshed”</p><p>“The lectures were thought provoking, at times convicting…”</p><p>“It was an incredible experience!”</p></div></section>
  <section class="values-section"><div class="wrap"><h2>{copy.grow}</h2><div class="values">
    <div><h3>Encouragement</h3><p>{copy.encouragementVerse}</p><p>{copy.encouragement}</p></div>
    <div><h3>Communication</h3><p>{copy.communication}</p></div>
    <div><h3>Joy</h3><p>{copy.joy}</p></div>
    <div><h3>Life together</h3><p>{copy.life}</p><p>{copy.closing}</p></div>
  </div></div></section>
  <section class="wrap next-steps"><div><p class="small-label">Media</p><h2>{copy.media}</h2><a class="text-link" href="/media">{copy.mediaCta} <span aria-hidden="true">→</span></a></div><div><h2>Donate</h2><p>{copy.donate}</p><p>{copy.donationPurpose}</p><a class="text-link" href="/funding">{copy.donationCta} <span aria-hidden="true">→</span></a></div></section>
</Base>
<style>
.wrap{max-width:1200px;margin:0 auto;padding-left:32px;padding-right:32px}
.home-hero{position:relative;min-height:580px;height:clamp(540px,65vw,650px);display:flex;align-items:center;color:#fff;background:#28382d;overflow:hidden}
.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 64%}
.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,24,19,.82),rgba(15,24,19,.5) 54%,rgba(15,24,19,.12))}
.hero-content{position:relative;width:100%;padding-top:48px;padding-bottom:56px}
.scripture{font-size:13px!important;margin:0 0 25px!important;line-height:1.7!important;font-weight:500}.scripture span{display:block;font-size:11px;opacity:.8}
.home-hero h1{font-size:clamp(40px,4.5vw,64px);font-weight:500;line-height:1.1;margin:0 0 24px;max-width:720px;letter-spacing:0}
.hero-content>p{font-size:17px;line-height:1.8;margin-bottom:30px;max-width:550px}
.hero-button{min-height:52px;gap:30px}
.introduction{display:grid;grid-template-columns:1fr 1.2fr;gap:80px;padding-top:80px;padding-bottom:82px}
.small-label{font-size:12px;font-weight:600;color:var(--color-accent);margin:0 0 15px}
h2{font-size:clamp(30px,3vw,43px);font-weight:500;line-height:1.2;margin:0 0 24px}
.intro-copy p{margin:0 0 18px;color:var(--color-muted);line-height:1.8}
.text-link{display:inline-flex;gap:20px;align-items:center;text-decoration:none;color:var(--color-text);font-weight:600;font-size:14px;padding-bottom:5px;border-bottom:1px solid var(--color-border)}.text-link:hover{border-color:var(--color-text)}
.gatherings-section{padding:72px 0;background:var(--color-surface)}
.section-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;gap:20px}.section-top h2{margin:0}
.season-note{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);padding:28px 0;gap:24px}.season-note h3{font-size:24px;margin:0 0 8px}.season-note p{font-size:14px;margin:0;color:var(--color-muted)}
.retreat-intro{display:grid;grid-template-columns:1.25fr 1fr;gap:55px;align-items:center;margin-top:48px}.retreat-intro img{width:100%;height:320px;object-fit:cover;border-radius:4px}.retreat-intro h3{font-size:32px;margin:0 0 20px}.retreat-intro p{font-size:15px;color:var(--color-muted);line-height:1.8}
.voices{text-align:center;padding-top:80px;padding-bottom:80px}.voices blockquote{max-width:850px;margin:20px auto 38px;font-family:Georgia,serif;font-size:clamp(24px,3vw,34px);line-height:1.5}.more-voices{max-width:860px;display:grid;grid-template-columns:1fr 1fr;gap:48px;margin:auto;color:var(--color-muted);font-size:14px}.more-voices p{margin:0}
.values-section{background:#273a31;color:white;padding:65px 0}.values{display:grid;grid-template-columns:repeat(4,1fr);gap:36px;margin-top:35px}.values h3{font-size:23px;color:#f3bd69;margin:0 0 15px}.values p{font-size:14px;line-height:1.8;color:#d1dad4;margin:0}.values-section h2{margin:0}
.next-steps{display:grid;grid-template-columns:1fr 1fr;gap:100px;padding-top:80px;padding-bottom:80px}.next-steps p:not(.small-label){color:var(--color-muted);font-size:15px;line-height:1.8;max-width:460px}.next-steps h2{font-size:33px}
.retreat-list{display:grid;gap:16px}.retreat-item{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--color-border);padding:24px;color:var(--color-text);text-decoration:none}.retreat-item h3{margin:10px 0;font-size:26px}.retreat-item span,.retreat-item p{font-size:14px}
@media(max-width:760px){.wrap{padding-left:22px;padding-right:22px}.home-hero{height:570px;min-height:0}.hero-photo{object-position:58% center}.hero-shade{background:rgba(15,24,19,.62)}.hero-content{padding-top:30px;padding-bottom:35px}.home-hero h1{font-size:40px}.hero-content>p{font-size:15px}.introduction,.retreat-intro,.next-steps{grid-template-columns:1fr;gap:25px}.introduction,.voices,.next-steps{padding-top:50px;padding-bottom:50px}.gatherings-section{padding:45px 0}.season-note{align-items:flex-start;flex-direction:column}.retreat-intro img{height:250px}.more-voices{grid-template-columns:1fr;gap:22px}.values{grid-template-columns:1fr 1fr;gap:28px}.next-steps{gap:45px}.section-top{align-items:flex-start}.section-top h2{font-size:31px}.section-top a{white-space:nowrap;font-size:12px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
</style>
