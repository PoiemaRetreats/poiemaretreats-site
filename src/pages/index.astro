---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { getRetreatStatus } from "../utils/retreats";

const [{ entries: allRetreats, cacheHint: retreatsHint }, { entries: articles, cacheHint: articlesHint }] =
	await Promise.all([
		getEmDashCollection("retreats", { status: "published" }),
		getEmDashCollection("articles", { status: "published", limit: 2, orderBy: { published_at: "desc" } }),
	]);

if (Astro.cache?.enabled) {
	if (retreatsHint) Astro.cache.set(retreatsHint);
	if (articlesHint) Astro.cache.set(articlesHint);
}

// Filter upcoming retreats
const upcomingRetreats = allRetreats
	.filter((r) => !getRetreatStatus(r.data).isPast)
	.sort((a, b) => new Date(a.data.start_date).getTime() - new Date(b.data.start_date).getTime())
	.slice(0, 3);
---

<Base
	title="Poiema Retreats — For We Are His Workmanship"
	description="The purpose of our retreats is to inform, encourage, and inspire Christian young adults regarding who they are in Christ — Ephesians 2:10."
>
	<div class="home-page">
		<!-- Hero Section -->
		<section class="hero-section">
			<div class="container hero-container">
				<div class="hero-badge">
					<span class="badge-greek">ποίημα</span>
					<span class="badge-verse">Ephesians 2:10</span>
				</div>
				<h1 class="hero-title">
					Formed by Grace.<br />Sustained in Fellowship.
				</h1>
				<p class="hero-lead">
					The purpose of our retreats is to inform, encourage, and inspire Christian young adults regarding who they are in Christ. We see this as a life-awareness that is essential for everyone’s spiritual walk as well as the wellspring of joy and confidence.
				</p>
				<p class="hero-sublead">
					After all, we are God’s workmanship (<em>poiema</em>) and we want that to set in, be real to us: worldview, apologetics, theology, vocation, and all of life set in true perspective.
				</p>
				<div class="hero-cta-group">
					<a href="/retreats" class="btn btn-primary btn-lg">
						View Upcoming Retreats &rarr;
					</a>
					<a href="/about" class="btn btn-secondary btn-lg">
						About Our Ministry
					</a>
				</div>
			</div>
		</section>

		<!-- Upcoming Gatherings Section -->
		<section class="section section-gatherings">
			<div class="container">
				<div class="section-header-home">
					<span class="section-kicker">Gatherings</span>
					<h2 class="section-title">Upcoming Conferences & Retreats</h2>
					<p class="section-subtitle">
						Step out of the daily churn. Join us for intentional days around Scripture, ocean and mountain air, and common tables.
					</p>
				</div>

				{upcomingRetreats.length === 0 ? (
					<div class="empty-state-home">
						<p>Retreat dates for the upcoming season are being finalized. Check back soon!</p>
					</div>
				) : (
					<div class="featured-retreats-grid">
						{upcomingRetreats.map((retreat) => {
							const status = getRetreatStatus(retreat.data);
							return (
								<article class="featured-card" {...retreat.edit}>
									<div class="featured-card-top">
										<span class={`status-badge ${status.badgeClass}`}>
											{status.badgeLabel}
										</span>
										{retreat.data.price && (
											<span class="featured-price">{retreat.data.price}</span>
										)}
									</div>

									<div class="featured-card-body">
										<h3 class="featured-title">
											<a href={`/retreats/${retreat.id}`}>{retreat.data.title}</a>
										</h3>

										{retreat.data.subtitle && (
											<p class="featured-subtitle">{retreat.data.subtitle}</p>
										)}

										<div class="featured-details">
											<div class="detail-row">
												<span class="detail-name">Dates:</span>
												<span class="detail-val">{status.dateRangeFormatted}</span>
											</div>
											<div class="detail-row">
												<span class="detail-name">Location:</span>
												<span class="detail-val">{retreat.data.location}</span>
											</div>
										</div>

										{retreat.data.excerpt && (
											<p class="featured-excerpt">{retreat.data.excerpt}</p>
										)}
									</div>

									<div class="featured-card-bottom">
										<a href={`/retreats/${retreat.id}`} class="btn btn-primary w-full">
											{status.isOpen ? "View Details & Register" : "View Details"} &rarr;
										</a>
									</div>
								</article>
							);
						})}
					</div>
				)}

				<div class="all-retreats-link-wrap">
					<a href="/retreats" class="link-muted-arrow">
						View all retreats & past gatherings archive &rarr;
					</a>
				</div>
			</div>
		</section>

		<!-- Testimonials Section (from poiemaretreats.org) -->
		<section class="section section-testimonials">
			<div class="container">
				<div class="section-header-home">
					<span class="section-kicker">Voices from Poiema</span>
					<h2 class="section-title">What Attendees Are Saying</h2>
					<p class="section-subtitle">
						Encouragement and reflections from college students and young adults.
					</p>
				</div>

				<div class="testimonials-grid">
					<blockquote class="testimonial-card">
						<p>“It was so nice to hang out with other Christians my age and hear lectures aimed towards us.”</p>
					</blockquote>
					<blockquote class="testimonial-card">
						<p>“The lectures were thought provoking, at times convicting…”</p>
					</blockquote>
					<blockquote class="testimonial-card">
						<p>“It was a huge blessing to be with the body of Christ and see that we are larger than just our small church.”</p>
					</blockquote>
					<blockquote class="testimonial-card">
						<p>“It was an incredible experience! I was so encouraged and refreshed.”</p>
					</blockquote>
				</div>
			</div>
		</section>

		<!-- Pillars Section (Core Values from poiemaretreats.org) -->
		<section class="section section-pillars">
			<div class="container">
				<div class="section-header-home">
					<span class="section-kicker">What We Cherish</span>
					<h2 class="section-title">The Heart of Poiema</h2>
					<p class="section-subtitle">
						Four foundational commitments woven into every gathering.
					</p>
				</div>

				<div class="pillars-grid">
					<div class="pillar-item">
						<div class="pillar-icon-box">01</div>
						<h3>Encouragement</h3>
						<p class="pillar-scripture">“...that I may be encouraged together with you by the mutual faith both of you and me.” — Romans 1:12</p>
						<p>Encouraging each other is woven into every activity, prayer, and conversation at Poiema.</p>
					</div>
					<div class="pillar-item">
						<div class="pillar-icon-box">02</div>
						<h3>Communication</h3>
						<p class="pillar-scripture">Interactive & Engaging</p>
						<p>Sure there are lectures, but they are interactive on purpose. Communication involves both speaking and listening so truth is understood and lived.</p>
					</div>
					<div class="pillar-item">
						<div class="pillar-icon-box">03</div>
						<h3>JOY</h3>
						<p class="pillar-scripture">The Joy of the Lord</p>
						<p>We just really have a good time wherever we are. Laughter, sure, but greater still, the joy of the Lord in every aspect—from dining to dancing to discussion.</p>
					</div>
					<div class="pillar-item">
						<div class="pillar-icon-box">04</div>
						<h3>Life Together</h3>
						<p class="pillar-scripture">Humility & Openness</p>
						<p>Transparency, humility, openness, looking on the interests of others, and genuinely caring. A fellowship you will never want to settle for less than.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Pastoral Articles Highlight -->
		{articles.length > 0 && (
			<section class="section section-articles">
				<div class="container">
					<div class="section-header-home">
						<span class="section-kicker">Writings</span>
						<h2 class="section-title">Pastoral Articles & Essays</h2>
						<p class="section-subtitle">
							Writings from our pastors and teachers on Christian discipleship, vocation, and communion.
						</p>
					</div>

					<div class="articles-summary-grid">
						{articles.map((article) => (
							<article class="article-summary-card" {...article.edit}>
								<span class="summary-author">{article.data.author}</span>
								<h3 class="summary-title">
									<a href={`/articles/${article.id}`}>{article.data.title}</a>
								</h3>
								{article.data.excerpt && (
									<p class="summary-excerpt">{article.data.excerpt}</p>
								)}
								<a href={`/articles/${article.id}`} class="summary-link">
									Read Essay &rarr;
								</a>
							</article>
						))}
					</div>

					<div class="all-retreats-link-wrap">
						<a href="/articles" class="link-muted-arrow">
							Browse all pastoral articles &rarr;
						</a>
					</div>
				</div>
			</section>
		)}

		<!-- Giving Banner -->
		<section class="section section-giving-callout">
			<div class="container">
				<div class="giving-banner-card">
					<div class="giving-banner-text">
						<span class="banner-kicker">Support Our Mission</span>
						<h2>Help Keep Retreats Affordable</h2>
						<p>
							Registration fees do not cover all our costs. We don’t want expense to be the reason someone doesn’t attend. Your donations provide scholarships and sustain our speakers.
						</p>
					</div>
					<div class="giving-banner-action">
						<a href="/funding" class="btn btn-primary btn-lg">
							Funding & Donation Info &rarr;
						</a>
					</div>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	/* Hero */
	.hero-section {
		background: radial-gradient(
				circle at 50% 15%,
				color-mix(in srgb, var(--color-brand) 8%, transparent) 0%,
				transparent 70%
			),
			var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		padding: var(--spacing-5xl) 0 var(--spacing-4xl);
		text-align: center;
	}

	.hero-container {
		max-width: 840px;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
		padding: 4px 14px;
		border-radius: var(--radius-full);
		margin-bottom: var(--spacing-lg);
		font-size: var(--font-size-xs);
		font-weight: 600;
	}

	.badge-greek {
		font-family: var(--font-heading);
		font-size: var(--font-size-sm);
		font-style: italic;
		color: var(--color-brand);
		letter-spacing: 0.05em;
	}

	.badge-verse {
		color: var(--color-text-muted);
		border-left: 1px solid var(--color-border);
		padding-left: var(--spacing-sm);
	}

	.hero-title {
		font-size: clamp(2.4rem, 5vw, 3.8rem);
		line-height: 1.1;
		font-weight: 700;
		color: var(--color-text-main);
		margin-bottom: var(--spacing-lg);
		letter-spacing: -0.02em;
	}

	.hero-lead {
		font-size: var(--font-size-lg);
		line-height: 1.6;
		color: var(--color-text-main);
		margin-bottom: var(--spacing-md);
		font-weight: 500;
	}

	.hero-sublead {
		font-size: var(--font-size-base);
		line-height: 1.6;
		color: var(--color-text-muted);
		margin-bottom: var(--spacing-2xl);
		max-width: 720px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero-cta-group {
		display: flex;
		gap: var(--spacing-md);
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Section Headings */
	.section {
		padding: var(--spacing-5xl) 0;
	}

	.section-header-home {
		text-align: center;
		max-width: 680px;
		margin: 0 auto var(--spacing-3xl);
	}

	.section-kicker {
		display: inline-block;
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-accent);
		margin-bottom: var(--spacing-xs);
	}

	.section-title {
		font-size: var(--font-size-3xl);
		color: var(--color-text-main);
		margin-bottom: var(--spacing-sm);
	}

	.section-subtitle {
		color: var(--color-text-muted);
		font-size: var(--font-size-base);
		line-height: 1.5;
	}

	/* Retreat Cards Grid */
	.featured-retreats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: var(--spacing-xl);
		margin-bottom: var(--spacing-2xl);
	}

	.featured-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.featured-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
	}

	.featured-card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--spacing-md);
	}

	.featured-price {
		font-size: var(--font-size-sm);
		font-weight: 700;
		color: var(--color-brand);
		background: color-mix(in srgb, var(--color-brand) 10%, transparent);
		padding: 2px 10px;
		border-radius: var(--radius-full);
	}

	.featured-title {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-xs);
	}

	.featured-title a {
		color: var(--color-text-main);
		text-decoration: none;
	}

	.featured-title a:hover {
		color: var(--color-brand);
	}

	.featured-subtitle {
		font-size: var(--font-size-xs);
		color: var(--color-accent);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: var(--spacing-md);
	}

	.featured-details {
		display: flex;
		flex-direction: column;
		gap: 6px;
		background: var(--color-surface-soft);
		border-radius: var(--radius-md);
		padding: var(--spacing-sm) var(--spacing-md);
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-xs);
	}

	.detail-row {
		display: flex;
		gap: var(--spacing-xs);
	}

	.detail-name {
		font-weight: 600;
		color: var(--color-text-muted);
		min-width: 60px;
	}

	.detail-val {
		color: var(--color-text-main);
		font-weight: 500;
	}

	.featured-excerpt {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		line-height: 1.5;
		margin-bottom: var(--spacing-lg);
	}

	.featured-card-bottom {
		margin-top: auto;
	}

	.w-full {
		width: 100%;
		display: block;
		text-align: center;
	}

	.all-retreats-link-wrap {
		text-align: center;
		margin-top: var(--spacing-xl);
	}

	.link-muted-arrow {
		color: var(--color-brand);
		font-weight: 600;
		text-decoration: none;
		font-size: var(--font-size-sm);
	}

	.link-muted-arrow:hover {
		text-decoration: underline;
	}

	/* Testimonials Section */
	.section-testimonials {
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--spacing-lg);
	}

	.testimonial-card {
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-accent);
		border-radius: var(--radius-md);
		padding: var(--spacing-lg);
		margin: 0;
	}

	.testimonial-card p {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		line-height: 1.4;
		font-style: italic;
		color: var(--color-text-main);
		margin: 0;
	}

	/* Pillars Section */
	.section-pillars {
		background: var(--color-surface-soft);
	}

	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--spacing-xl);
	}

	.pillar-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
	}

	.pillar-icon-box {
		width: 36px;
		height: 36px;
		background: color-mix(in srgb, var(--color-brand) 12%, transparent);
		color: var(--color-brand);
		font-weight: 700;
		font-size: var(--font-size-xs);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-md);
		margin-bottom: var(--spacing-md);
	}

	.pillar-item h3 {
		font-size: var(--font-size-lg);
		margin-bottom: 4px;
		color: var(--color-text-main);
	}

	.pillar-scripture {
		font-size: var(--font-size-xs);
		color: var(--color-accent);
		font-weight: 600;
		margin-bottom: var(--spacing-sm);
		font-style: italic;
	}

	.pillar-item p:last-child {
		font-size: var(--font-size-sm);
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Articles Section */
	.section-articles {
		background: var(--color-surface);
	}

	.articles-summary-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: var(--spacing-xl);
	}

	.article-summary-card {
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		display: flex;
		flex-direction: column;
	}

	.summary-author {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: var(--color-accent);
		margin-bottom: var(--spacing-xs);
	}

	.summary-title {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-sm);
	}

	.summary-title a {
		color: var(--color-text-main);
		text-decoration: none;
	}

	.summary-title a:hover {
		color: var(--color-brand);
	}

	.summary-excerpt {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		line-height: 1.5;
		margin-bottom: var(--spacing-lg);
	}

	.summary-link {
		margin-top: auto;
		color: var(--color-brand);
		font-weight: 600;
		text-decoration: none;
		font-size: var(--font-size-sm);
	}

	.summary-link:hover {
		text-decoration: underline;
	}

	/* Giving Banner */
	.section-giving-callout {
		background: var(--color-surface-soft);
		border-top: 1px solid var(--color-border);
	}

	.giving-banner-card {
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--color-brand) 12%, var(--color-surface)),
			color-mix(in srgb, var(--color-accent) 8%, var(--color-surface))
		);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		padding: var(--spacing-3xl);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-2xl);
		flex-wrap: wrap;
	}

	.giving-banner-text {
		max-width: 600px;
	}

	.banner-kicker {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 700;
		color: var(--color-accent);
		margin-bottom: var(--spacing-xs);
		display: block;
	}

	.giving-banner-text h2 {
		font-size: var(--font-size-2xl);
		color: var(--color-text-main);
		margin-bottom: var(--spacing-sm);
	}

	.giving-banner-text p {
		color: var(--color-text-muted);
		line-height: 1.5;
		margin: 0;
	}

	@media (max-width: 768px) {
		.giving-banner-card {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
