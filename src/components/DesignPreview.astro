---
import "../styles/design-preview.css";
import { copy } from "../data/original-copy";

interface Props {
  variant: "coast" | "gather" | "heritage";
}

const { variant } = Astro.props;
const nav = [
  ["About", "/about"],
  ["Retreats", "/retreats"],
  ["Media", "/media"],
  ["Funding", "/funding"],
  ["Contact", "/contact"],
];
---

<div class={`poiema-preview poiema-${variant}`}>
  <div class="concept-bar">Design concept <span>{variant}</span></div>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Poiema home">
      <span class="wordmark-mark">P</span>
      <span>POIEMA<small>Retreats</small></span>
    </a>
    <details class="mobile-nav">
      <summary aria-label="Open navigation"><span></span><span></span></summary>
      <nav>{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
    </details>
    <nav class="desktop-nav" aria-label="Main navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </header>

  {variant === "coast" && (
    <main>
      <section class="coast-hero">
        <img src="/images/poiema-gathering.webp" alt="Young adults gathered together at a Poiema retreat" />
        <div class="coast-shade"></div>
        <div class="coast-hero-copy">
          <p class="kicker">{copy.scripture}</p>
          <h1>{copy.headline}</h1>
          <p>{copy.purpose}</p>
          <div class="actions"><a class="primary" href="/retreats">{copy.retreatCta}</a><a class="text-link" href="/about">About <span>↗</span></a></div>
        </div>
        <p class="scripture-tag">Ephesians 2:10</p>
      </section>

      <section class="coast-purpose">
        <div><p class="section-no">01 / About</p><h2>What is our Purpose?</h2></div>
        <div class="purpose-copy"><p>{copy.awareness}</p><p>{copy.workmanship}</p><a href="/about">About <span>→</span></a></div>
      </section>

      <section class="coast-paths">
        <article><span>Retreats</span><h3>{copy.grow}</h3><p>{copy.origin}</p><a href="/retreats">{copy.retreatCta}</a></article>
        <article class="coast-photo"><img src="/images/poiema-fellowship.webp" alt="Friends sharing time together during a retreat" /></article>
        <article><span>Media</span><h3>{copy.media}</h3><a href="/media">{copy.mediaCta}</a></article>
      </section>
    </main>
  )}

  {variant === "gather" && (
    <main>
      <section class="gather-hero">
        <div class="gather-copy">
          <p class="kicker">ποίημα</p>
          <h1>{copy.headline}</h1>
          <p class="lede">{copy.purpose}</p>
          <div class="actions"><a class="primary" href="/retreats">{copy.retreatCta}</a><a class="text-link" href="/media">{copy.mediaCta}</a></div>
          <blockquote>{copy.scripture} <cite>Ephesians 2:10</cite></blockquote>
        </div>
        <div class="gather-collage">
          <div class="orange-note">inform<br />encourage<br />inspire</div>
          <img class="gather-main" src="/images/poiema-gathering.webp" alt="Poiema retreat group enjoying time together" />
          <img class="gather-small" src="/images/poiema-fellowship.webp" alt="Young adults in fellowship at a Poiema retreat" />
          <div class="sun-mark" aria-hidden="true">✦</div>
        </div>
      </section>

      <section class="gather-intro">
        <p>{copy.awareness}</p>
        <a href="/about">About <span>→</span></a>
      </section>

      <section class="gather-grid">
        <div class="gather-title"><span>Retreats</span><h2>{copy.grow}</h2></div>
        <a class="gather-item retreat" href="/retreats"><span>01</span><h3>Retreats</h3><p>{copy.origin}</p><b>{copy.retreatCta} ↗</b></a>
        <a class="gather-item media" href="/media"><span>02</span><h3>Media</h3><p>{copy.media}</p><b>{copy.mediaCta} ↗</b></a>
        <a class="gather-item support" href="/funding"><span>03</span><h3>Donate</h3><p>{copy.donationPurpose}</p><b>{copy.donationCta} ↗</b></a>
      </section>
    </main>
  )}

  {variant === "heritage" && (
    <main>
      <section class="heritage-hero">
        <div class="heritage-rule"><span>Poiema Retreats</span><span>Bristol, Virginia</span></div>
        <div class="heritage-hero-grid">
          <div class="heritage-heading"><p>POIEMA <i>ποί­ημα</i></p><h1>{copy.headline}</h1></div>
          <div class="heritage-side"><p>{copy.purpose}</p><a class="primary" href="/retreats">{copy.retreatCta}</a></div>
        </div>
        <div class="heritage-image"><img src="/images/poiema-gathering.webp" alt="Young adults gathered at a Poiema retreat" /><span>Ephesians 2:10</span></div>
      </section>

      <section class="heritage-purpose">
        <p class="dropcap">{copy.awareness}</p>
        <div><p>{copy.workmanship}</p><a href="/about">About →</a></div>
      </section>

      <section class="heritage-offerings">
        <header><span>Retreats</span><h2>{copy.grow}</h2></header>
        <div class="heritage-list">
          <a href="/retreats"><span>I</span><div><h3>Retreats</h3><p>{copy.origin}</p></div><b>→</b></a>
          <a href="/media"><span>II</span><div><h3>Media</h3><p>{copy.media}</p></div><b>→</b></a>
          <a href="/funding"><span>III</span><div><h3>Donate</h3><p>{copy.donationPurpose}</p></div><b>→</b></a>
        </div>
      </section>
    </main>
  )}

  <footer class="site-footer">
    <div class="footer-word">POIEMA</div>
    <div><p>A ministry of Saint Peter Presbyterian Church</p><p>Bristol, Virginia</p></div>
    <nav>{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
    <a class="footer-contact" href="/contact">Contact ↗</a>
  </footer>
</div>
