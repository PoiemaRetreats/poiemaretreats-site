---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: articles, cacheHint } = await getEmDashCollection("articles", {
	status: "published",
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled && cacheHint) {
	Astro.cache.set(cacheHint);
}
---

<Base
	title="Pastoral Articles & Essays"
	description="Writings, theological reflections, and teachings from the pastors and leaders of Poiema Retreats."
>
	<div class="articles-page">
		<header class="page-header">
			<div class="container">
				<span class="sub-heading">Writings & Reflections</span>
				<h1 class="page-title">Pastoral Articles</h1>
				<p class="page-intro">
					Biblical perspectives on vocation, Christian adulthood, theology, and common life from our pastoral team.
				</p>
			</div>
		</header>

		<section class="section">
			<div class="container">
				{articles.length === 0 ? (
					<div class="empty-state">
						<p>No articles published yet. Check back soon for new pastoral writings.</p>
					</div>
				) : (
					<div class="articles-list">
						{articles.map((article) => {
							const rawDate = article.data.publishedAt;
							const formattedDate = rawDate
								? new Date(rawDate).toLocaleDateString("en-US", {
										month: "long",
										day: "numeric",
										year: "numeric",
									})
								: null;

							return (
								<article class="article-card" {...article.edit}>
									<div class="article-meta">
										<span class="article-author">{article.data.author}</span>
										{formattedDate && (
											<>
												<span class="meta-dot">&bull;</span>
												<time datetime={rawDate ? new Date(rawDate).toISOString() : undefined}>
													{formattedDate}
												</time>
											</>
										)}
									</div>

									<h2 class="article-title">
										<a href={`/articles/${article.id}`}>{article.data.title}</a>
									</h2>

									{article.data.excerpt && (
										<p class="article-excerpt">{article.data.excerpt}</p>
									)}

									<a href={`/articles/${article.id}`} class="read-more-link">
										Read Essay &rarr;
									</a>
								</article>
							);
						})}
					</div>
				)}
			</div>
		</section>
	</div>
</Base>

<style>
	.container {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	.page-header {
		padding: var(--spacing-4xl) 0 var(--spacing-3xl);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.sub-heading {
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		display: block;
		margin-bottom: var(--spacing-xs);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		margin: 0 0 var(--spacing-md);
		color: var(--color-text-main);
	}

	.page-intro {
		max-width: 680px;
		margin: 0 auto;
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		line-height: 1.6;
		font-style: italic;
		font-family: var(--font-heading);
	}

	.section {
		padding: var(--spacing-4xl) 0 var(--spacing-5xl);
	}

	.empty-state {
		text-align: center;
		padding: var(--spacing-4xl);
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.articles-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl);
	}

	.article-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-2xl);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.article-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		margin-bottom: var(--spacing-xs);
	}

	.article-author {
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
	}

	.meta-dot {
		color: var(--color-border);
	}

	.article-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-sm);
	}

	.article-title a {
		color: var(--color-text-main);
		text-decoration: none;
	}

	.article-title a:hover {
		color: var(--color-brand);
	}

	.article-excerpt {
		color: var(--color-text-muted);
		font-size: var(--font-size-base);
		line-height: 1.6;
		margin-bottom: var(--spacing-lg);
	}

	.read-more-link {
		color: var(--color-brand);
		font-weight: 600;
		text-decoration: none;
		font-size: var(--font-size-sm);
	}

	.read-more-link:hover {
		text-decoration: underline;
	}
</style>
