---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: mediaItems, cacheHint } = await getEmDashCollection("recordings", {
	status: "published",
});

if (Astro.cache?.enabled && cacheHint) {
	Astro.cache.set(cacheHint);
}

// Sort chronologically
const sortedMedia = [...mediaItems].sort((a, b) => {
	const timeA = a.data.date ? new Date(String(a.data.date)).getTime() : 0;
	const timeB = b.data.date ? new Date(String(b.data.date)).getTime() : 0;
	return timeB - timeA;
});
---

<Base
	title="Media & Audio Archive"
	description="Lectures, evening devotions, and psalm singing recordings from Poiema Retreats."
>
	<div class="media-page">
		<header class="page-header">
			<div class="container">
				<span class="sub-heading">Audio & Teaching</span>
				<h1 class="page-title">Sermons, Podcasts & Lectures</h1>
				<p class="page-intro">
					Listen to lectures, devotions, and psalm singing from past conferences and retreats.
				</p>
			</div>
		</header>

		<section class="section">
			<div class="container">
				{sortedMedia.length === 0 ? (
					<div class="empty-state">
						<p>No media recordings published yet. Check back soon for audio archives.</p>
					</div>
				) : (
					<div class="media-grid">
						{sortedMedia.map((item) => {
							const dateStr = item.data.date ? String(item.data.date) : null;
							const formattedDate = dateStr
								? new Date(dateStr).toLocaleDateString("en-US", {
										month: "short",
										day: "numeric",
										year: "numeric",
									})
								: null;
							
							const mediaUrl = item.data.media_url ? String(item.data.media_url) : null;
							const isAudioFile = mediaUrl ? /\.(m4a|mp3|ogg|wav)$/i.test(mediaUrl) : false;

							return (
								<article class="media-card" {...item.edit}>
									<div class="media-card-top">
										<span class="media-type-badge">{item.data.media_type}</span>
										{formattedDate && <span class="media-date">{formattedDate}</span>}
									</div>

									<h3 class="media-title">{item.data.title}</h3>

									{item.data.speaker && (
										<p class="media-speaker">Speaker: <strong>{item.data.speaker}</strong></p>
									)}

									{item.data.description && (
										<p class="media-desc">{item.data.description}</p>
									)}

									{isAudioFile && mediaUrl && (
										<div class="audio-player-wrapper">
											<audio controls preload="none" src={mediaUrl} class="native-audio">
												Your browser does not support the audio element.
											</audio>
										</div>
									)}

									<div class="media-actions">
										{mediaUrl ? (
											<a
												href={mediaUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="btn btn-secondary btn-sm"
											>
												Direct Audio Link &rarr;
											</a>
										) : (
											<span class="media-unavailable">Audio coming soon</span>
										)}
									</div>
								</article>
							);
						})}
					</div>
				)}
			</div>
		</section>
	</div>
</Base>

<style>
	.container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-xl);
	}

	.page-header {
		padding: var(--spacing-4xl) 0 var(--spacing-3xl);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.sub-heading {
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		display: block;
		margin-bottom: var(--spacing-xs);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		margin: 0 0 var(--spacing-md);
		color: var(--color-text-main);
	}

	.page-intro {
		max-width: 680px;
		margin: 0 auto;
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		line-height: 1.6;
		font-style: italic;
		font-family: var(--font-heading);
	}

	.section {
		padding: var(--spacing-4xl) 0 var(--spacing-5xl);
	}

	.empty-state {
		text-align: center;
		padding: var(--spacing-4xl);
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.media-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: var(--spacing-xl);
	}

	.media-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.media-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
	}

	.media-card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--spacing-md);
	}

	.media-type-badge {
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		background: color-mix(in srgb, var(--color-brand) 12%, transparent);
		color: var(--color-brand);
		padding: 3px 10px;
		border-radius: var(--radius-full);
	}

	.media-date {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
	}

	.media-title {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-xs);
		color: var(--color-text-main);
	}

	.media-speaker {
		font-size: var(--font-size-xs);
		color: var(--color-accent);
		margin-bottom: var(--spacing-md);
	}

	.media-speaker strong {
		color: var(--color-text-main);
	}

	.media-desc {
		font-size: var(--font-size-sm);
		line-height: 1.6;
		color: var(--color-text-muted);
		margin-bottom: var(--spacing-lg);
	}

	.audio-player-wrapper {
		margin-bottom: var(--spacing-md);
		width: 100%;
	}

	.native-audio {
		width: 100%;
		height: 38px;
		border-radius: var(--radius-sm);
		outline: none;
	}

	.media-actions {
		margin-top: auto;
		display: flex;
		align-items: center;
	}

	.media-unavailable {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		font-style: italic;
	}

	.btn-sm {
		padding: 6px 14px;
		font-size: var(--font-size-xs);
	}
</style>
